<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" xmlns:c="http://jmix.io/schema/flowui/jpql-condition" title="msg://partnerListView.title" focusComponent="partnersDataGrid">
    <data>
        <collection id="partnersDc" class="com.company.warehousemanagement.entity.Partner">
            <fetchPlan extends="_base"/>
            <loader id="partnersDl" readOnly="true">
                <query>
                    <![CDATA[
                    select e from Partner e where (:searchTerm is null or trim(:searchTerm) = '' or (lower(coalesce(e.code, '')) like concat('%', lower(:searchTerm), '%') OR lower(coalesce(e.name, '')) like concat('%', lower(:searchTerm), '%') OR lower(coalesce(e.email, '')) like concat('%', lower(:searchTerm), '%')))
                ]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="false"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout classNames="warehouse-page-layout">
<hbox id="buttonsPanel" wrap="true" width="100%" classNames="warehouse-toolbar">
            <startSlot>
                <textField id="searchField" placeholder="msg://searchPlaceholder" clearButtonVisible="true" valueChangeMode="LAZY" width="22em" classNames="warehouse-search-field"></textField>
                <button id="createButton" action="partnersDataGrid.createAction" themeNames="primary" icon="vaadin:plus" text="Tạo mới"/>
                <button id="editButton" action="partnersDataGrid.editAction" icon="vaadin:pencil" text="Sửa"/>
                <button id="readButton" action="partnersDataGrid.readAction" icon="vaadin:eye" text="Xem chi tiết"/>
                <button id="removeButton" action="partnersDataGrid.removeAction" themeNames="error" icon="vaadin:trash" text="Xóa"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="partnersDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="partnersDataGrid" width="100%" minHeight="20em" dataContainer="partnersDc" columnReorderingAllowed="true" classNames="warehouse-data-grid">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="readAction" type="list_read"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code"/>
                <column property="name"/>
                <column property="email"/>
                <column property="partnerType"/>
                <column property="active"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" text="Chọn"/>
            <button id="discardButton" action="discardAction" text="Đóng"/>
        </hbox>
    </layout>
</view>
