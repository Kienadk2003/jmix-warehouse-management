<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://userProductCategoryDetailView.title" focusComponent="form">
    <data>
        <instance id="userProductCategoryDc" class="com.company.warehousemanagement.entity.UserProductCategory">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="productCategory" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="userProductCategoryDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout classNames="warehouse-page-layout">
        <formLayout id="form" dataContainer="userProductCategoryDc" classNames="warehouse-form-layout">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="userField" property="user">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="productCategoryField" property="productCategory">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions" classNames="warehouse-detail-actions">
            <button id="saveAndCloseButton" action="saveCloseAction" text="Lưu và đóng"/>
            <button id="closeButton" action="closeAction" text="Đóng"/>
        </hbox>
    </layout>
</view>
