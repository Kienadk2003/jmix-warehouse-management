<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://userProductCategoryListView.title"
      focusComponent="userProductCategoriesDataGrid">
    <data>
        <collection id="userProductCategoriesDc"
                    class="com.company.warehousemanagement.entity.UserProductCategory">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="productCategory" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="userProductCategoriesDl" readOnly="true">
                <query>
                    <![CDATA[select e from UserProductCategory e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="userProductCategoriesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="addButton" action="userProductCategoriesDataGrid.addAction"/>
                <button id="createButton" action="userProductCategoriesDataGrid.createAction"/>
                <button id="editButton" action="userProductCategoriesDataGrid.editAction"/>
                <button id="readButton" action="userProductCategoriesDataGrid.readAction"/>
                <button id="removeButton" action="userProductCategoriesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="userProductCategoriesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="userProductCategoriesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="userProductCategoriesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="addAction" type="list_add"/>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="readAction" type="list_read"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="user"/>
                <column property="productCategory"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
