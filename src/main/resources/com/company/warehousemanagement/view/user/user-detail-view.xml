<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://UserDetailView.title" focusComponent="form">
    <data>
        <instance id="userDc" class="com.company.warehousemanagement.entity.User">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout classNames="warehouse-page-layout">
        <formLayout id="form" dataContainer="userDc" classNames="warehouse-form-layout">
            <textField id="usernameField" property="username" readOnly="true"/>
            <passwordField id="passwordField" label="msg://com.company.warehousemanagement.entity/User.password" required="true" visible="false"/>
            <passwordField id="confirmPasswordField" label="msg://confirmPassword" required="true" visible="false"/>
            <textField id="firstNameField" property="firstName"/>
            <textField id="lastNameField" property="lastName"/>
            <textField id="emailField" property="email"/>
            <comboBox id="timeZoneField" property="timeZoneId" clearButtonVisible="true"/>
            <checkbox id="activeField" property="active"/>
        </formLayout>
        <hbox id="detailActions" classNames="warehouse-detail-actions">
            <button id="saveAndCloseButton" action="saveCloseAction" text="Lưu và đóng"/>
            <button id="closeButton" action="closeAction" text="Đóng"/>
        </hbox>
    </layout>
</view>
