<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://UserWarehouseListView.title" focusComponent="userWarehousesDataGrid">

    <data>
        <collection id="userWarehousesDc" class="com.company.warehousemanagement.entity.UserWarehouse">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>

            <loader id="userWarehousesDl" readOnly="true">
                <query>
                    
                        select e
                        from UserWarehouse e
                        order by e.user.username, e.warehouse.code
                    
                </query>
            </loader>
        </collection>
    </data>

    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <layout classNames="warehouse-page-layout">

        <hbox id="buttonsPanel" width="100%" wrap="true" classNames="warehouse-toolbar">

            <startSlot>

                <button id="createButton" action="userWarehousesDataGrid.createAction" text="Tạo mới" themeNames="primary"/>

                <button id="editButton" action="userWarehousesDataGrid.editAction" text="Chỉnh sửa"/>

                <button id="removeButton" action="userWarehousesDataGrid.removeAction" text="Xóa" themeNames="error"/>

            </startSlot>

            <endSlot>

                <simplePagination id="pagination" dataLoader="userWarehousesDl"/>

            </endSlot>

        </hbox>

        <dataGrid id="userWarehousesDataGrid" width="100%" minHeight="20em" dataContainer="userWarehousesDc" columnReorderingAllowed="true" classNames="warehouse-data-grid">

            <actions>

                <action id="createAction" type="list_create"/>

                <action id="editAction" type="list_edit"/>

                <action id="removeAction" type="list_remove"/>

            </actions>

            <columns resizable="true">

                <column property="user"/>

                <column property="warehouse"/>

            </columns>

        </dataGrid>

        <hbox id="lookupActions" visible="false">

            <button id="selectButton" action="selectAction" text="Chọn"/>

            <button id="discardButton" action="discardAction" text="Đóng"/>

        </hbox>

    </layout>

</view>
