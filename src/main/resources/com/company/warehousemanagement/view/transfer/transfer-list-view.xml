<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://transferListView.title" focusComponent="transfersDataGrid">

    <data>
        <collection id="transfersDc" class="com.company.warehousemanagement.entity.WarehouseTransaction">

            <fetchPlan extends="_base">
                <property name="sourceWarehouse" fetchPlan="_base"/>
                <property name="destinationWarehouse" fetchPlan="_base"/>
                <property name="items" fetchPlan="_base"/>
            </fetchPlan>

            <loader id="transfersDl">
                <query>
                    
                        select e
                        from WarehouseTransaction e
                        where e.type = 'TRANSFER'
                          and (:searchTerm is null or trim(:searchTerm) = ''
                               or lower(coalesce(e.documentNo, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.sourceWarehouse.code, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.sourceWarehouse.name, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.destinationWarehouse.code, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.destinationWarehouse.name, '')) like concat('%', lower(:searchTerm), '%'))
                        order by e.documentDate desc,
                                 e.documentNo desc
                    
                </query>
            </loader>

        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="false"/>
        <urlQueryParameters/>
    </facets>

    <layout classNames="warehouse-page-layout">

        <!-- FILTER -->

        <!-- BUTTONS -->
<hbox id="buttonsPanel" classNames="buttons-panel warehouse-toolbar" wrap="true" width="100%">
            <textField id="searchField" placeholder="msg://searchPlaceholder" clearButtonVisible="true" valueChangeMode="LAZY" width="22em" classNames="warehouse-search-field"/>
            <button id="createButton" action="transfersDataGrid.create" icon="vaadin:plus" text="msg://button.create" themeNames="primary"/>
            <button id="editButton" action="transfersDataGrid.edit" icon="vaadin:pencil" text="msg://button.edit"/>
            <button id="readButton" action="transfersDataGrid.read" icon="vaadin:eye" text="msg://button.viewDetails"/>
            <button id="removeButton" action="transfersDataGrid.remove" icon="vaadin:trash" text="msg://button.delete" themeNames="error"/>
            <simplePagination id="pagination" dataLoader="transfersDl"/>
        </hbox>

        <!-- GRID -->
        <dataGrid id="transfersDataGrid" dataContainer="transfersDc" width="100%" minHeight="20em" classNames="warehouse-data-grid">

            <actions>

                <action id="create" type="list_create">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="edit" type="list_edit">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="read" type="list_read">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="remove" type="list_remove"/>
            </actions>

            <columns resizable="true">

                <column property="documentNo" header="msg://column.documentNo"/>

                <column property="sourceWarehouse" header="msg://column.sourceWarehouse"/>

                <column property="destinationWarehouse" header="msg://column.destinationWarehouse"/>

                <column property="documentDate" header="msg://column.documentDate"/>

                <column property="status" header="msg://column.status"/>

            </columns>

        </dataGrid>

        <vbox id="transfersEmptyState" visible="false" width="100%" classNames="warehouse-empty-card" alignItems="CENTER" padding="false" spacing="false">
            <icon icon="vaadin:box" classNames="warehouse-empty-card-icon"/>
            <span id="transfersEmptyTitle" text="msg://emptyState.title" classNames="warehouse-empty-card-title"/>
            <span id="transfersEmptyHint" text="msg://emptyState.hint" classNames="warehouse-empty-card-hint"/>
        </vbox>

    </layout>

</view>
