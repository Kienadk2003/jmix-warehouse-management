<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="Phiếu chuyển kho" focusComponent="transfersDataGrid">

    <data>
        <collection id="transfersDc" class="com.company.warehousemanagement.entity.WarehouseTransaction">

            <fetchPlan extends="_base">
                <property name="sourceWarehouse" fetchPlan="_base"/>
                <property name="destinationWarehouse" fetchPlan="_base"/>
                <property name="items" fetchPlan="_base"/>
            </fetchPlan>

            <loader id="transfersDl">
                <query>
                    
                        select e
                        from WarehouseTransaction e
                        where e.type = 'TRANSFER'
                        order by e.documentDate desc,
                                 e.documentNo desc
                    
                </query>
            </loader>

        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters/>
    </facets>

    <layout classNames="warehouse-page-layout">

        <!-- FILTER -->
        <genericFilter id="genericFilter" dataLoader="transfersDl" classNames="warehouse-filter"/>

        <!-- BUTTONS -->
        <hbox id="buttonsPanel" classNames="buttons-panel warehouse-toolbar">

            <button id="createButton" action="transfersDataGrid.create" text="Tạo mới" themeNames="primary"/>

            <button id="editButton" action="transfersDataGrid.edit" text="Chỉnh sửa"/>

            <button id="readButton" action="transfersDataGrid.read" text="Xem chi tiết"/>

            <button id="removeButton" action="transfersDataGrid.remove" text="Xóa" themeNames="error"/>

        </hbox>

        <!-- GRID -->
        <dataGrid id="transfersDataGrid" dataContainer="transfersDc" width="100%" minHeight="20em" classNames="warehouse-data-grid">

            <actions>

                <action id="create" type="list_create">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="edit" type="list_edit">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="read" type="list_read">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.transferDetail"/>
                    </properties>
                </action>

                <action id="remove" type="list_remove"/>
            </actions>

            <columns resizable="true">

                <column property="documentNo" header="Số phiếu"/>

                <column property="sourceWarehouse" header="Kho xuất"/>

                <column property="destinationWarehouse" header="Kho nhận"/>

                <column property="documentDate" header="Ngày chứng từ"/>

                <column property="status" header="Trạng thái"/>

            </columns>

        </dataGrid>

        <simplePagination id="pagination" dataLoader="transfersDl"/>

    </layout>

</view>
