<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="Báo cáo tồn kho">

    <data>

        <!-- =========================
             WAREHOUSE
             ========================= -->

        <collection id="warehousesDc" class="com.company.warehousemanagement.entity.Warehouse">

            <fetchPlan extends="_instance_name"/>

            <loader id="warehousesDl">

                <query>
                    <![CDATA[
                        select e
                        from Warehouse e
                        order by e.id
                    ]]>
                </query>

            </loader>

        </collection>


        <!-- =========================
             PRODUCT
             ========================= -->

        <collection id="productsDc" class="com.company.warehousemanagement.entity.Product">

            <fetchPlan extends="_instance_name"/>

            <loader id="productsDl">

                <query>
                    <![CDATA[
                        select e
                        from Product e
                        order by e.id
                    ]]>
                </query>

            </loader>

        </collection>


        <!-- =========================
             REPORT DATA
             ========================= -->

        <keyValueCollection id="reportDc">

            <properties>

                <property name="warehouse" class="com.company.warehousemanagement.entity.Warehouse"/>

                <property name="product" class="com.company.warehousemanagement.entity.Product"/>

                <property name="opening" datatype="decimal"/>

                <property name="inbound" datatype="decimal"/>

                <property name="outbound" datatype="decimal"/>

                <property name="adjustmentIn" datatype="decimal"/>

                <property name="adjustmentOut" datatype="decimal"/>

                <property name="closing" datatype="decimal"/>

            </properties>

        </keyValueCollection>

    </data>


    <facets>

        <dataLoadCoordinator auto="true"/>

    </facets>


    <layout padding="true" spacing="true" classNames="warehouse-page-layout">


        <!-- =========================
             FILTER
             ========================= -->

        <formLayout id="filterForm" classNames="warehouse-form-layout">

            <entityComboBox id="warehouseField" metaClass="Warehouse" itemsContainer="warehousesDc" label="Kho"/>

            <entityComboBox id="productField" metaClass="Product" itemsContainer="productsDc" label="Sản phẩm"/>

            <datePicker id="fromDateField" datatype="localDate" label="Từ ngày" required="true"/>

            <datePicker id="toDateField" datatype="localDate" label="Đến ngày" required="true"/>

        </formLayout>


        <hbox id="buttonsPanel" classNames="buttons-panel warehouse-toolbar">

            <button id="searchButton" text="Search"/>

            <button id="excelExportButton" action="reportDataGrid.excelExport" text="Xuất Excel"/>

        </hbox>


        <!-- =========================
             REPORT TABLE
             ========================= -->

        <dataGrid id="reportDataGrid" dataContainer="reportDc" width="100%" minHeight="25em" classNames="warehouse-data-grid">
            <actions>

                <action id="excelExport" type="grdexp_excelExport"/>

            </actions>

            <columns>

                <column property="warehouse" header="Kho"/>

                <column property="product" header="Sản phẩm"/>

                <column property="opening" header="Tồn đầu kỳ" textAlign="END"/>

                <column property="inbound" header="Nhập trong kỳ" textAlign="END"/>

                <column property="outbound" header="Xuất trong kỳ" textAlign="END"/>

                <column property="adjustmentIn" header="Điều chỉnh tăng" textAlign="END"/>

                <column property="adjustmentOut" header="Điều chỉnh giảm" textAlign="END"/>

                <column property="closing" header="Tồn cuối kỳ" textAlign="END"/>

            </columns>

        </dataGrid>

    </layout>

</view>
