<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" xmlns:c="http://jmix.io/schema/flowui/jpql-condition" title="msg://warehouseListView.title" focusComponent="warehousesDataGrid">
    <data>
        <collection id="warehousesDc" class="com.company.warehousemanagement.entity.Warehouse">
            <fetchPlan extends="_base"/>
            <loader id="warehousesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Warehouse e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout classNames="warehouse-page-layout">
        <genericFilter id="genericFilter" dataLoader="warehousesDl" classNames="warehouse-filter">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%" classNames="warehouse-toolbar">
            <startSlot>
                <button id="createButton" action="warehousesDataGrid.createAction" themeNames="primary" text="Tạo mới"/>
                <button id="editButton" action="warehousesDataGrid.editAction" text="Chỉnh sửa"/>
                <button id="readButton" action="warehousesDataGrid.readAction" text="Xem chi tiết"/>
                <button id="removeButton" action="warehousesDataGrid.removeAction" themeNames="error" text="Xóa"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="warehousesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="warehousesDataGrid" width="100%" minHeight="20em" dataContainer="warehousesDc" columnReorderingAllowed="true" classNames="warehouse-data-grid">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="readAction" type="list_read"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code"/>
                <column property="name"/>
                <column property="address"/>
                <column property="active"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" text="Chọn"/>
            <button id="discardButton" action="discardAction" text="Đóng"/>
        </hbox>
    </layout>
</view>
