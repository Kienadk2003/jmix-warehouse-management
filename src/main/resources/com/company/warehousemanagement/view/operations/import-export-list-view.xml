<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Nhập – Xuất kho"
      focusComponent="receiptsDataGrid">
    <data>
        <collection id="receiptsDc" class="com.company.warehousemanagement.entity.WarehouseTransaction">
            <fetchPlan extends="_base">
                <property name="destinationWarehouse" fetchPlan="_base"/>
                <property name="partner" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="receiptsDl" readOnly="true">
                <query><![CDATA[
                    select e from WarehouseTransaction e
                    where e.type = 'IMPORT'
                    order by e.documentDate desc, e.documentNo desc
                ]]></query>
            </loader>
        </collection>
        <collection id="exportsDc" class="com.company.warehousemanagement.entity.WarehouseTransaction">
            <fetchPlan extends="_base">
                <property name="sourceWarehouse" fetchPlan="_base"/>
                <property name="partner" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="exportsDl" readOnly="true">
                <query><![CDATA[
                    select e from WarehouseTransaction e
                    where e.type = 'EXPORT'
                    order by e.documentDate desc, e.documentNo desc
                ]]></query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout classNames="warehouse-page-layout">
        <tabSheet id="transactionTabs" width="100%">
            <tab id="importTab" label="Phiếu nhập">
                <vbox width="100%">
                    <genericFilter id="receiptsFilter" dataLoader="receiptsDl" classNames="warehouse-filter">
                        <properties include=".*"/>
                    </genericFilter>
                    <hbox id="importButtonsPanel" width="100%" wrap="true" classNames="warehouse-toolbar">
                        <startSlot>
                            <button id="createImportButton" text="Tạo phiếu nhập" themeNames="primary"/>
                            <button id="openImportButton" text="Xem chi tiết"/>
                            <button id="refreshImportButton" text="Làm mới"/>
                        </startSlot>
                        <endSlot>
                            <simplePagination id="receiptsPagination" dataLoader="receiptsDl"/>
                        </endSlot>
                    </hbox>
                    <dataGrid id="receiptsDataGrid" width="100%" minHeight="25em"
                              dataContainer="receiptsDc" columnReorderingAllowed="true"
                              classNames="warehouse-data-grid">
                        <columns resizable="true">
                            <column property="documentNo" header="Số phiếu"/>
                            <column property="documentDate" header="Ngày chứng từ"/>
                            <column property="destinationWarehouse" header="Kho nhận"/>
                            <column property="partner" header="Nhà cung cấp"/>
                            <column property="status" header="Trạng thái"/>
                            <column property="postedBy" header="Người ghi sổ"/>
                            <column property="postedAt" header="Thời gian ghi sổ"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
            <tab id="exportTab" label="Phiếu xuất">
                <vbox width="100%">
                    <genericFilter id="exportsFilter" dataLoader="exportsDl" classNames="warehouse-filter">
                        <properties include=".*"/>
                    </genericFilter>
                    <hbox id="exportButtonsPanel" width="100%" wrap="true" classNames="warehouse-toolbar">
                        <startSlot>
                            <button id="createExportButton" action="exportsDataGrid.createAction"
                                    text="Tạo phiếu xuất" themeNames="primary"/>
                            <button id="editExportButton" action="exportsDataGrid.editAction" text="Chỉnh sửa"/>
                            <button id="readExportButton" action="exportsDataGrid.readAction" text="Xem chi tiết"/>
                            <button id="refreshExportButton" action="exportsDataGrid.refreshAction" text="Làm mới"/>
                        </startSlot>
                        <endSlot>
                            <simplePagination id="exportsPagination" dataLoader="exportsDl"/>
                        </endSlot>
                    </hbox>
                    <dataGrid id="exportsDataGrid" width="100%" minHeight="25em"
                              dataContainer="exportsDc" columnReorderingAllowed="true"
                              classNames="warehouse-data-grid">
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties>
                                    <property name="viewId" value="WarehouseTransaction.exportDetail"/>
                                </properties>
                            </action>
                            <action id="editAction" type="list_edit">
                                <properties>
                                    <property name="viewId" value="WarehouseTransaction.exportDetail"/>
                                </properties>
                            </action>
                            <action id="readAction" type="list_read">
                                <properties>
                                    <property name="viewId" value="WarehouseTransaction.exportDetail"/>
                                </properties>
                            </action>
                            <action id="refreshAction" type="list_refresh"/>
                        </actions>
                        <columns resizable="true">
                            <column property="documentNo" header="Số phiếu" sortable="true"/>
                            <column property="sourceWarehouse" header="Kho xuất" sortable="true"/>
                            <column property="partner" header="Đối tác" sortable="true"/>
                            <column property="documentDate" header="Ngày chứng từ" sortable="true"/>
                            <column property="status" header="Trạng thái" sortable="true"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
        </tabSheet>
    </layout>
</view>
