<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://productCategoryDetailView.title" focusComponent="form">
    <data>
        <instance id="productCategoryDc" class="com.company.warehousemanagement.entity.ProductCategory">
            <fetchPlan extends="_base"/>
            <loader id="productCategoryDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout classNames="warehouse-page-layout">
        <formLayout id="form" dataContainer="productCategoryDc" classNames="warehouse-form-layout">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="codeField" property="code"/>
            <textField id="nameField" property="name"/>
            <textField id="descriptionField" property="description"/>
            <checkbox id="activeField" property="active"/>
        </formLayout>
        <hbox id="detailActions" classNames="warehouse-detail-actions">
            <button id="saveAndCloseButton" action="saveCloseAction" text="Lưu và đóng"/>
            <button id="closeButton" action="closeAction" text="Đóng"/>
        </hbox>
    </layout>
</view>
