<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="Thẻ kho">

    <data>

        <!-- =========================
             WAREHOUSE
             ========================= -->

        <collection id="warehousesDc" class="com.company.warehousemanagement.entity.Warehouse">

            <fetchPlan extends="_instance_name"/>

            <loader id="warehousesDl">

                <query>
                    <![CDATA[
                        select e
                        from Warehouse e
                        order by e.id
                    ]]>
                </query>

            </loader>

        </collection>


        <!-- =========================
             PRODUCT
             ========================= -->

        <collection id="productsDc" class="com.company.warehousemanagement.entity.Product">

            <fetchPlan extends="_instance_name"/>

            <loader id="productsDl">

                <query>
                    <![CDATA[
                        select e
                        from Product e
                        order by e.id
                    ]]>
                </query>

            </loader>

        </collection>


        <!-- =========================
             STOCK CARD DATA
             ========================= -->

        <keyValueCollection id="stockCardDc">

            <properties idProperty="movementId">

                <property name="movementId" datatype="uuid"/>

                <property name="movementTime" datatype="string"/>

                <property name="documentNo" datatype="string"/>

                <property name="transactionType" datatype="string"/>

                <property name="movementType" datatype="string"/>

                <property name="signedQuantity" datatype="decimal"/>

                <property name="runningBalance" datatype="decimal"/>

            </properties>

        </keyValueCollection>

    </data>


    <facets>

        <dataLoadCoordinator auto="true"/>

    </facets>


    <layout padding="true" spacing="true" classNames="warehouse-page-layout">


        <!-- =========================
             FILTER
             ========================= -->

        <formLayout id="filterForm" classNames="warehouse-form-layout">

            <entityComboBox id="warehouseField" label="Kho" metaClass="Warehouse" itemsContainer="warehousesDc" required="true"/>

            <entityComboBox id="productField" label="Sản phẩm" metaClass="Product" itemsContainer="productsDc" required="true"/>

            <datePicker id="fromDateField" label="Từ ngày" datatype="localDate" required="true"/>

            <datePicker id="toDateField" label="Đến ngày" datatype="localDate" required="true"/>
        </formLayout>


        <hbox id="filterButtons" classNames="buttons-panel warehouse-toolbar">

            <button id="searchButton" text="Search"/>

        </hbox>


        <!-- =========================
             SUMMARY
             ========================= -->

        <formLayout id="summaryForm" classNames="warehouse-form-layout">

            <textField id="openingStockField" label="Tồn đầu kỳ" readOnly="true"/>

            <textField id="closingStockField" label="Tồn cuối kỳ" readOnly="true"/>

            <textField id="currentInventoryField" label="Tồn hiện tại" readOnly="true"/>

        </formLayout>


        <!-- =========================
             STOCK CARD
             ========================= -->

        <dataGrid id="stockCardDataGrid" dataContainer="stockCardDc" width="100%" minHeight="25em" classNames="warehouse-data-grid">

            <columns>

                <column property="movementTime" header="Thời gian phát sinh"/>

                <column property="documentNo" header="Số phiếu"/>

                <column property="transactionType" header="Loại phiếu"/>

                <column property="movementType" header="Loại biến động"/>

                <column property="signedQuantity" header="Số lượng" textAlign="END"/>

                <column property="runningBalance" header="Tồn sau giao dịch" textAlign="END"/>

            </columns>

        </dataGrid>

    </layout>

</view>
