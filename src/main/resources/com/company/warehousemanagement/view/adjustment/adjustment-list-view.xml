<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="Adjustment">

    <data readOnly="true">

        <collection id="adjustmentsDc" class="com.company.warehousemanagement.entity.WarehouseTransaction">

            <fetchPlan extends="_base">

                <property name="sourceWarehouse" fetchPlan="_instance_name"/>

            </fetchPlan>

            <loader id="adjustmentsDl">

                <query>
                    <![CDATA[
                        select e
                        from WarehouseTransaction e
                        where e.type = 'ADJUSTMENT'
                          and (:searchTerm is null or trim(:searchTerm) = ''
                               or lower(coalesce(e.documentNo, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.sourceWarehouse.name, '')) like concat('%', lower(:searchTerm), '%')
                               or lower(coalesce(e.reason, '')) like concat('%', lower(:searchTerm), '%'))
                        order by e.documentDate desc
                    ]]>
                </query>

            </loader>

        </collection>

    </data>

    <facets>
        <dataLoadCoordinator auto="false"/>
    </facets>

    <layout padding="true" classNames="warehouse-page-layout">
<hbox id="buttonsPanel" width="100%" wrap="true" classNames="buttons-panel warehouse-toolbar">

            <textField id="searchField" placeholder="msg://searchPlaceholder" clearButtonVisible="true" valueChangeMode="LAZY" width="22em" classNames="warehouse-search-field"></textField>

            <button id="createButton" action="adjustmentsDataGrid.create" themeNames="primary" icon="vaadin:plus" text="Tạo mới"/>

            <button id="editButton" action="adjustmentsDataGrid.edit" icon="vaadin:pencil" text="Sửa"/>

            <button id="readButton" action="adjustmentsDataGrid.read" icon="vaadin:eye" text="Xem chi tiết"/>

            <button id="refreshButton" action="adjustmentsDataGrid.refresh" icon="vaadin:refresh" text="Làm mới"/>

        </hbox>

        <dataGrid id="adjustmentsDataGrid" dataContainer="adjustmentsDc" width="100%" minHeight="20em" classNames="warehouse-data-grid">

            <actions>

                <action id="create" type="list_create">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.adjustmentDetail"/>
                    </properties>
                </action>

                <action id="edit" type="list_edit">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.adjustmentDetail"/>
                    </properties>
                </action>

                <action id="read" type="list_read">
                    <properties>
                        <property name="viewId" value="WarehouseTransaction.adjustmentDetail"/>
                    </properties>
                </action>

                <action id="refresh" type="list_refresh"/>

            </actions>

            <columns>

                <column property="documentNo" header="Document No"/>

                <column property="sourceWarehouse" header="Warehouse"/>

                <column property="adjustmentDirection" header="Direction"/>

                <column property="documentDate" header="Document Date"/>

                <column property="status" header="Status"/>

                <column property="reason" header="Reason"/>

            </columns>

        </dataGrid>

    </layout>

</view>
