<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- New table only: no existing data or table is modified. -->
    <changeSet id="20261015-app-notification" author="khoflow">
        <createTable tableName="APP_NOTIFICATION">
            <column name="ID" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="RECIPIENT_USERNAME" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="TYPE" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="SUBJECT_TYPE" type="VARCHAR(20)"/>
            <column name="SUBJECT_NO" type="VARCHAR(50)"/>
            <column name="ACTOR_NAME" type="VARCHAR(255)"/>
            <column name="DETAIL" type="VARCHAR(500)"/>
            <column name="TARGET_VIEW_ID" type="VARCHAR(100)"/>
            <column name="TARGET_ROUTE" type="VARCHAR(255)"/>
            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="READ_FLAG" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="READ_AT" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="APP_NOTIFICATION" indexName="IDX_APP_NOTIF_RECIPIENT_READ">
            <column name="RECIPIENT_USERNAME"/>
            <column name="READ_FLAG"/>
        </createIndex>
        <createIndex tableName="APP_NOTIFICATION" indexName="IDX_APP_NOTIF_RECIPIENT_CREATED">
            <column name="RECIPIENT_USERNAME"/>
            <column name="CREATED_AT"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
